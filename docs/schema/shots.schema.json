{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vidbrief 01_preprocess/shots.json",
  "description": "关键截图清单 + agent 的校准结论。步 1 由工具生成,步 2/3 由 agent 增删改(record_shot_check / extract_shot / update_shot)。设计见 docs/DESIGN.md §4.6、§6.1。⚠️ status / reason / check 三栏**只是投影**:判据在 state.bin(§4.10),手改这里骗不过门,只会被 vidbrief status 记一笔。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_at",
    "shots"
  ],
  "properties": {
    "generated_at": {
      "$ref": "#/$defs/timestamp",
      "description": "首次生成时间;后续增删改不更新此值"
    },
    "shots": {
      "type": "array",
      "description": "按 t 升序。agent 判定 drop 的条目仍保留在数组里,只改 status",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "t",
          "file",
          "origin",
          "region_id",
          "status",
          "reason",
          "created_at",
          "check"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/shot_id",
            "description": "项目内单调递增、永不复用:任何日志或对话里出现过的 id 永远指同一张图"
          },
          "t": {
            "type": "number",
            "minimum": 0,
            "description": "截取时刻(秒),取该时刻的帧"
          },
          "file": {
            "$ref": "#/$defs/relpath",
            "description": "图片文件的项目根相对路径。步 1 的图在 01_preprocess/shots/,补图在 02_calibrate/shots_extra/ 或 03_summary/shots_extra2/"
          },
          "origin": {
            "type": "string",
            "enum": [
              "dense_region",
              "isolated_peak",
              "agent_request",
              "manual"
            ],
            "description": "这张图从哪来"
          },
          "region_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "description": "origin 为 dense_region / isolated_peak 时指向 dense_regions.json,否则为 null"
          },
          "status": {
            "type": "string",
            "enum": [
              "keep",
              "drop"
            ],
            "description": "是否保留(**投影**;判据在 state.bin)。新生成的**有内容**的图默认 keep;步 1 认出**纯色帧**(切黑 / 淡出 / 纯色占位)时照样把图截下来,但预标成 drop —— 图是那个事件的证据,省的是看的人(它不进待校准那一批);agent 觉得有用可以 update_shot(keep) 改回来"
          },
          "reason": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "description": "这张图的**处置理由**(**投影**;判据在 state.bin):补图时写为什么要补(origin 为 agent_request / manual 时应有值),步 1 预标弃用的纯色帧写为什么被弃用"
          },
          "created_at": {
            "$ref": "#/$defs/timestamp",
            "description": "这张图被加入清单的时间(补图会晚于 generated_at)"
          },
          "check": {
            "description": "agent 通过 record_shot_check 写入的看图结论;未校准时为 null。**投影**:判据在 state.bin(§4.10)",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "match",
                  "audio_visual_sync",
                  "type_read",
                  "neighbor_text",
                  "issues",
                  "confidence",
                  "evidence",
                  "checked_at"
                ],
                "properties": {
                  "match": {
                    "type": "boolean",
                    "description": "画面讲的与同期转录讲的是不是**同一件事**(主题 / 动作 / 对象)。**用字层面的差异不算不符** —— 转录把一个字听错了是转录纠错的活(apply_corrections),不是这里;判据是「这段话配这张图,读的人会不会觉得对不上」。两种读法都说得通的字段迟早被填成两个样,所以这条写死(实测两个模型给过相反答案)"
                  },
                  "audio_visual_sync": {
                    "type": "boolean",
                    "description": "画面与语音在时间上是否对得上"
                  },
                  "type_read": {
                    "type": "string",
                    "minLength": 1,
                    "description": "从画面读到的内容(对象/规格/状态/数值)。画面无法确认时如实写「画面无法确认」"
                  },
                  "neighbor_text": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ],
                    "description": "该时刻前后 ±6s 的转录原文,作为判断依据留档"
                  },
                  "issues": {
                    "type": "array",
                    "description": "发现的问题,每条一句;无问题为空数组",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "high",
                      "medium",
                      "low"
                    ],
                    "description": "agent 对自己结论的把握程度。不确定就用 low,不要猜"
                  },
                  "checked_at": {
                    "$ref": "#/$defs/timestamp"
                  },
                  "evidence": {
                    "description": "这条结论凭的是哪句话。null = 没有凭据(证据这套之前写的结论)。工具只核两件机械的事:那段文在转录里找得到吗、那张图的文件还在吗",
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "segment",
                          "quote"
                        ],
                        "properties": {
                          "segment": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "由工具按 quote 自己找出来的段号,不是模型报的"
                          },
                          "quote": {
                            "type": "string",
                            "minLength": 1,
                            "description": "照抄的转录原文,落在一段之内"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "relpath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/.\\\\:][^/\\\\:]*(/[^/.\\\\:][^/\\\\:]*)*$"
    },
    "shot_id": {
      "type": "string",
      "pattern": "^s[0-9]{3,}$"
    }
  }
}
