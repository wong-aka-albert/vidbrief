{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vidbrief project.json",
  "description": "项目元数据、各步进度标记、用户确认。设计见 docs/DESIGN.md §4.2,约定见 docs/schema/README.md。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rev",
    "id",
    "name",
    "created_at",
    "source",
    "glossary",
    "progress"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "该项目下所有 JSON 文件的格式版本;不兼容变更时 +1"
    },
    "rev": {
      "type": "integer",
      "minimum": 0,
      "description": "乐观并发修订号(§4.7);工具每次成功写入本文件时 +1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "项目 id,同时是 projects/ 下的目录名"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "人类可读名称,可含中文"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "original",
        "link"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relpath",
          "description": "项目内视频副本或软链接的位置,如 source/video.mp4"
        },
        "original": {
          "type": "string",
          "minLength": 1,
          "description": "源视频的原始绝对路径。纯信息性,不用于访问文件(可能是 Windows 路径)"
        },
        "link": {
          "type": "string",
          "enum": [
            "hardlink",
            "symlink",
            "copy"
          ],
          "description": "源视频进入项目的方式。只有 copy 的项目是自包含的;硬链接/软链接的项目依赖原文件还在"
        }
      }
    },
    "glossary": {
      "description": "术语表;默认 null = 关闭。非 null 时每项是一个正确写法",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preprocess",
        "calibrate",
        "summarize",
        "report"
      ],
      "properties": {
        "preprocess": {
          "$ref": "#/$defs/step_progress"
        },
        "calibrate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rounds",
            "last_at"
          ],
          "properties": {
            "rounds": {
              "type": "integer",
              "minimum": 0,
              "description": "校准迭代轮数。校准不设通过/未通过,只记轮数"
            },
            "last_at": {
              "$ref": "#/$defs/nullable_timestamp"
            }
          }
        },
        "summarize": {
          "$ref": "#/$defs/step_progress"
        },
        "report": {
          "$ref": "#/$defs/step_progress"
        }
      }
    },
    "review": {
      "description": "用户对各步的确认 —— 审核门。缺省视作谁都没确认过",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibrate"
      ],
      "properties": {
        "calibrate": {
          "description": "步 2(校准)的确认。null = 还没被确认过;非 null 时,数一变就作废",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/approval"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "RFC 3339 带 UTC 偏移,如 2026-09-24T21:00:00+08:00"
    },
    "nullable_timestamp": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/timestamp"
        }
      ]
    },
    "relpath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/.\\\\:][^/\\\\:]*(/[^/.\\\\:][^/\\\\:]*)*$",
      "description": "项目根相对路径,以 / 分隔。禁止绝对路径、盘符、反斜杠、以点开头的段(. 与 ..)"
    },
    "step_progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "done",
        "at"
      ],
      "properties": {
        "done": {
          "type": "boolean"
        },
        "at": {
          "$ref": "#/$defs/nullable_timestamp"
        }
      }
    },
    "review_counts": {
      "description": "确认当时数下来的四项。全是服务端自己数得出来的,不含自报值",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unchecked",
        "needing_review",
        "supplement_pending",
        "uncertain"
      ],
      "properties": {
        "unchecked": {
          "type": "integer",
          "minimum": 0,
          "description": "还没校准的截图张数"
        },
        "needing_review": {
          "type": "integer",
          "minimum": 0,
          "description": "需要人裁决的截图张数"
        },
        "supplement_pending": {
          "type": "integer",
          "minimum": 0,
          "description": "还没处理过的补图候选条数"
        },
        "uncertain": {
          "type": "integer",
          "minimum": 0,
          "description": "标了存疑但没改、等人裁决的转录段数"
        }
      }
    },
    "material_digests": {
      "description": "确认当时的材料内容,逐条一个短摘要。任何一条对不上,这次确认就作废 —— 判据是它,不是 counts(计数抓不住「只改了一个字」)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segments",
        "shots",
        "supplements"
      ],
      "properties": {
        "segments": {
          "$ref": "#/$defs/digest_map",
          "description": "转录里被动过的段(改过或标了存疑),键是段 id。没被动过的段不进这里 —— 原始转录永不就地改写,它们没有会变的字段"
        },
        "shots": {
          "$ref": "#/$defs/digest_map",
          "description": "每张截图一个,键是截图 id(如 s003)"
        },
        "supplements": {
          "$ref": "#/$defs/digest_map",
          "description": "每条补图候选一个,键是候选 id"
        }
      }
    },
    "digest_map": {
      "description": "id → 8 位十六进制的内容摘要",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}$"
      }
    },
    "approval": {
      "description": "一次确认。没有 approved_by —— 拿不到,填不出来的字段迟早被填成假的",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_at",
        "counts",
        "digests",
        "note"
      ],
      "properties": {
        "approved_at": {
          "$ref": "#/$defs/timestamp"
        },
        "counts": {
          "$ref": "#/$defs/review_counts"
        },
        "digests": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/material_digests"
            }
          ],
          "description": "确认当时的材料内容。**判据是它**:变了就作废。null = 这次确认签在摘要这版之前,那时没法判断材料后来有没有被改过 —— 门会说「查不了,再确认一次」,而不是假装材料变了"
        },
        "note": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "description": "带着未处理项通过时的说明;正常通过是 null"
        }
      }
    }
  }
}
