{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vidbrief 01_preprocess/dense_regions.json",
  "description": "算法从差帧图识别出的变化密集区。算法见 docs/DESIGN.md §5.2,格式见 §4.4。",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "params", "stats", "regions"],
  "properties": {
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "params": {
      "type": "object",
      "description": "本次运行使用的可调参数(输入)。阈值需随视频类型自适应,故必须落盘以便重跑对比",
      "additionalProperties": false,
      "required": [
        "window",
        "peak_threshold",
        "mass_k",
        "mass_floor",
        "merge_gap",
        "static_break"
      ],
      "properties": {
        "window": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "滑窗宽度 W(秒),默认 8.0"
        },
        "peak_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "孤立硬切换的 score 阈值,默认 0.25"
        },
        "mass_k": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "密集区阈值 = max(窗口中位数 × mass_k, mass_floor),默认 3.0"
        },
        "mass_floor": {
          "type": "number",
          "minimum": 0,
          "description": "密集区阈值的绝对下限,防止静止视频整段被判为密集"
        },
        "merge_gap": {
          "type": "number",
          "minimum": 0,
          "description": "相邻密集区间隔小于该值(秒)时合并"
        },
        "static_break": {
          "type": "number",
          "minimum": 0,
          "description": "长静止判据:静止超过该值(秒)后的首次变化记为章节起点,默认 120.0"
        }
      }
    },
    "stats": {
      "type": "object",
      "description": "本次运行算出的中间量(输出)。用于复现阈值判定与调参对比",
      "additionalProperties": false,
      "required": ["sampled_points", "mass_median", "mass_threshold"],
      "properties": {
        "sampled_points": {
          "type": "integer",
          "minimum": 1,
          "description": "参与计算的变化点数量,应与 change_curve.changes 等长"
        },
        "mass_median": {
          "type": "number",
          "minimum": 0,
          "description": "滑窗累计值的中位数"
        },
        "mass_threshold": {
          "type": "number",
          "minimum": 0,
          "description": "实际生效的密集区阈值 = max(mass_median × mass_k, mass_floor)"
        }
      }
    },
    "regions": {
      "type": "array",
      "description": "按时间升序。允许为空(整段无显著变化的视频)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start", "end", "mass", "peak_t", "peak_score", "reason"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "项目内唯一,从 1 起按时间顺序编号"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0,
            "description": "点事件(孤立峰/章节起点)时与 start 相等"
          },
          "mass": {
            "type": "number",
            "minimum": 0,
            "description": "区间内变化量累计(未归一化),用于排序与过滤"
          },
          "peak_t": {
            "type": "number",
            "minimum": 0,
            "description": "区间内 score 最大处的时刻,代表帧取这里"
          },
          "peak_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "enum": ["high_density", "isolated_peak", "long_static_break"],
            "description": "被哪条判据选中"
          }
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
